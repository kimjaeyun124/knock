# 사용법: 이 파일을 .env 로 복사해서 사용합니다.  cp .env.example .env
# .env 는 Git에 커밋하지 않습니다.
#
# 이 파일의 값은 "서버 전용"과 "브라우저 공개용"으로 나뉩니다.
# 브라우저로 전달되는 값은 VITE_ 접두사가 붙은 것뿐입니다.
# 비밀키·토큰·비밀번호는 절대 VITE_ 접두사를 붙이지 마세요.

# ───────── 서버 전용 (apps/server) ─────────

# 서버가 바인딩할 주소. 같은 네트워크의 다른 기기(스마트폰 등)에서 접속하려면 0.0.0.0
SERVER_HOST=127.0.0.1
SERVER_PORT=4000

# Socket.IO CORS·출처 검사에 허용할 웹 출처. 웹 개발 서버 주소와 같아야 합니다.
CLIENT_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# SQLite 파일 경로. 상대 경로는 apps/server 기준입니다. (파일은 Git에 올라가지 않습니다)
DATABASE_URL=file:./prisma/dev.db

# 세션 쿠키의 Secure 속성. 비워 두면(주석 처리) 운영(NODE_ENV=production)에서만 켜집니다.
# HTTPS 없이 운영 모드로 로컬 테스트를 할 때만 false 로 지정하세요.
# COOKIE_SECURE=false

# 앞단에 리버스 프록시(Caddy, nginx 등)가 있다면 그 단계 수(보통 1). 없으면 0(기본).
# 프록시 뒤에서 0 이면 모든 접속자가 한 IP 로 보여 로그인 시도 제한이 정상 보호자까지 막을 수 있고,
# 실제보다 크면 접속자가 IP 를 속일 수 있습니다. 자세한 내용은 docs/OPERATIONS.md
# TRUST_PROXY=1

# 외부 감시(권장): 서버가 멈추면 서버가 보내는 알림도 멈춥니다. 이 주소(예: Healthchecks.io 의 ping 주소,
# Uptime Kuma 의 push 주소)로 서버가 건강할 때만 GET 신호를 보내므로, 신호가 끊기면 그 서비스가 알려 줍니다. https 만 가능.
# HEARTBEAT_PING_URL=https://hc-ping.com/<발급받은-값>
# HEARTBEAT_PING_INTERVAL_SECONDS=60

# 자동 백업(권장): 지정해야 서버가 데이터베이스를 주기적으로 백업합니다. (없으면 백업하지 않음)
# 개인정보가 들어 있으니 서버 디스크와 다른 곳(외장·다른 기기)을 권장합니다. docs/OPERATIONS.md 6절
# BACKUP_DIR=/var/backups/tetris
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7

# 접속자(IP) 한 곳이 1분에 보낼 수 있는 사용자용 API 요청 수 (기본 1200, 0 이면 제한 없음)
# API_RATE_LIMIT_PER_MINUTE=1200

# 운영 실행 시에는 셸에서 NODE_ENV=production 을 지정합니다. (.env 에 넣지 않습니다)

# 센서 시뮬레이터(/api/dev/simulator, 웹 /dev/simulator)를 켤지. 비워 두면(주석 처리)
# 개발에서는 켜지고 운영(NODE_ENV=production)에서는 꺼집니다. 끄면 경로와 화면이 모두 사라집니다.
# 시뮬레이터가 만든 데이터는 항상 "시뮬레이션"으로 표시되며 설정 → 데이터 관리에서 지울 수 있습니다.
# SIMULATOR_ENABLED=true

# ───────── 브라우저 푸시 (선택, 서버 전용) ─────────
# 세 값을 모두 채우면 브라우저 푸시가 "실제 연동"이 되고, 비워 두면 "연동되지 않음"으로 표시됩니다.
# 키 만들기: npm run vapid:generate  (VAPID_PRIVATE_KEY 는 비밀값입니다. 저장소에 올리지 마세요)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:운영자-이메일@example.com

# ───────── 개발용 데이터 (npm run db:seed) ─────────

# 시드가 만드는 데모 보호자(demo@example.com)의 비밀번호. 12자 이상.
# 아래 값은 예시이며 개발 PC 밖에서는 절대 사용하지 마세요. 운영 환경에서는 시드가 실행되지 않습니다.
SEED_DEMO_PASSWORD=demo-only-change-me-1234

# ───────── 웹 개발 서버 설정 (apps/web/vite.config.ts, 브라우저로 전달되지 않음) ─────────

WEB_PORT=5173

# ───────── 브라우저 공개용 (VITE_ 접두사) ─────────

# API 서버의 절대 주소. 비워 두면 같은 출처(/api)로 요청하며,
# 개발 중에는 Vite 프록시가 SERVER_HOST:SERVER_PORT 로 전달합니다.
VITE_API_BASE_URL=

# 개발 중 서버에 아직 없는 기능을 샘플 데이터(Mock)로 바꿔 볼 때만 사용합니다. (쉼표 구분)
# 켜면 화면 상단에 "일부 화면이 샘플 데이터입니다"가 표시됩니다.
# 운영 빌드(npm run build)는 이 값이 비어 있지 않으면 실패합니다.
# 현재 Mock 이 있는 기능: integrations (연동 현황)
VITE_MOCK_FEATURES=

# 실행 모드. 비워 두면(또는 api) 모든 화면이 실제 서버 데이터를 씁니다.
# demo 로 하면 서버가 아직 주지 못하는 화면(대시보드·센서·움직임 기록·연동 현황)을 테스트 데이터(샘플)로
# 채우고, 모든 화면 위에 "데모 모드입니다. … 테스트 데이터"를 표시합니다. 로그인·알림·설정은 실제 서버를 씁니다.
# demo 에서 VITE_MOCK_FEATURES 를 함께 주면 그 기능만 샘플로 바꿉니다.
# 운영 빌드(npm run build)는 demo 이면 실패합니다. (개발 전용)
VITE_APP_MODE=

# ───────── 이후 단계에서 추가될 항목 (아직 사용하지 않음) ─────────
