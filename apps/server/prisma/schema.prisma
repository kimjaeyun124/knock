// 노크 데이터 모델 (docs/IMPLEMENTATION_PLAN.md 6절)
//
// - enum 값은 packages/shared/src/domain.ts 의 상수와 같아야 한다.
//   (apps/server/src/db/schema.test.ts 가 두 목록이 어긋나면 실패하도록 검사한다)
// - 원본 이벤트(MovementEvent)는 수정하지 않는다. 알림·상태는 이벤트에서 파생된다.
// - 모든 사용자 데이터에 householdId 를 두어 이후 다중 가구 지원을 막지 않는다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum GuardianRole {
  OWNER
  MEMBER
}

enum ZoneKind {
  BED_SIDE
  PATH
  ENTRANCE
}

enum SensorKind {
  MOTION
}

enum DataOrigin {
  REAL
  SIMULATED
}

enum Sensitivity {
  LOW
  MEDIUM
  HIGH
}

enum SensorStatusLogKind {
  CONNECTED
  DISCONNECTED
  BATTERY_LOW
  BATTERY_CRITICAL
  BATTERY_OK
}

enum AlertType {
  BED_AREA_ACTIVITY
  BED_TO_PATH
  ENTRANCE_APPROACH
  REPEATED_MOVEMENT
  SENSOR_OFFLINE
  SENSOR_RESTORED
  LOW_BATTERY
  DELIVERY_FAILED
}

enum AlertSeverity {
  INFO
  NOTICE
  URGENT
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum Resolution {
  CHECKED
  FALSE_ALARM
  AUTO_RESOLVED // 조건이 해소되어 시스템이 자동으로 종료 (센서 연결 복구 등)
}

enum Channel {
  IN_APP
  WEB_PUSH
  WATCH
  SMS
  KAKAO
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  NOT_CONFIGURED
  CANCELLED // 알림이 확인·종료되어 전달을 멈춤
}

/// 움직임 신호의 분류(판단 엔진이 받을 때 정해 저장). 값은 packages/shared 의 MOVEMENT_CLASSES 와 같아야 한다.
enum MovementClass {
  BED_EXIT_CANDIDATE // 야간 모니터링 시간의 침대 주변 신호. 침대를 벗어났을 "가능성"일 뿐 확정이 아니다.
  ENTRANCE_ACTIVITY // 야간 모니터링 시간의 현관 신호. 외출·실종을 뜻하지 않는다.
  MOTION_DETECTED // 그 밖의 움직임(이동 경로, 모니터링 시간 밖)
}

enum ProviderMode {
  REAL
  MOCK
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  /// 초기 설정 마법사를 끝내고 서비스 안내를 확인한 시각. 아직이면 null
  setupCompletedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  /// 초기 설정에서 마지막으로 도달한 단계(1~6). 도중에 나가도 이어 하도록 저장한다.
  onboardingStep Int @default(1)

  guardians Guardian[]
  recipient CareRecipient?
  settings  DetectionSettings?
  alertPreferences AlertPreferences?
  sensors   Sensor[]
  events    MovementEvent[]
  alerts    Alert[]
}

model Guardian {
  id           String       @id @default(cuid())
  householdId  String
  email        String       @unique // 소문자로 정규화해 저장
  passwordHash String // scrypt$N$r$p$salt$hash
  displayName  String
  role         GuardianRole @default(OWNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  household  Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sessions   Session[]
  deliveries NotificationDelivery[]
  pushSubscriptions PushSubscription[]
  alertReads AlertRead[]

  @@index([householdId])
}

/// 브라우저 푸시를 받을 기기(브라우저) 한 곳. 보호자가 직접 등록한다.
model PushSubscription {
  id         String   @id @default(cuid())
  guardianId String
  endpoint   String   @unique // 푸시 서비스가 정한 주소. 이 주소로 알림을 보낸다
  p256dh     String // 암호화 키 (공개)
  auth       String // 암호화에 쓰는 인증 비밀. 서버 밖으로 내보내지 않는다
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
}

model Session {
  id         String   @id // 세션 토큰의 SHA-256. 토큰 원문은 저장하지 않는다.
  guardianId String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@index([expiresAt])
}

model CareRecipient {
  id          String   @id @default(cuid())
  householdId String   @unique
  alias       String // 실명 금지. "어르신" 같은 호칭만 저장한다.
  memo        String? // 선택 메모(200자 이내). 건강 정보·연락처 등은 받지 않는다고 안내한다.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model DetectionSettings {
  householdId            String      @id
  monitoringEnabled      Boolean     @default(true) // 끄면 움직임 알림을 만들지 않는다 (신호는 기록)
  activeWeekdays         Int         @default(127) // 요일 비트마스크: 월=1 화=2 수=4 목=8 금=16 토=32 일=64. 야간 구간이 시작되는 날 기준
  nightStart             String      @default("22:00") // HH:mm, Asia/Seoul
  nightEnd               String      @default("06:00") // 자정을 넘는 구간 지원
  sensitivity            Sensitivity @default(MEDIUM)
  sequenceWindowMinutes  Int         @default(10)
  cooldownMinutes        Int         @default(10)
  reminderMinutes        Int         @default(5)
  offlineAfterSeconds    Int         @default(300)
  lowBatteryPercent      Int         @default(20)
  criticalBatteryPercent Int         @default(10)
  retentionDays          Int         @default(90)
  updatedAt              DateTime    @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

/// 어떤 알림을 받을지 (가구별). 끈 종류의 알림은 만들지 않는다.
model AlertPreferences {
  householdId      String   @id
  bedAreaActivity  Boolean  @default(true)
  bedToPath        Boolean  @default(true)
  entranceApproach Boolean  @default(true)
  repeatedMovement Boolean  @default(true)
  sensorIssues     Boolean  @default(true)
  lowBattery       Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Sensor {
  id              String     @id @default(cuid())
  householdId     String
  /// 장치 고유 번호(일련번호·MAC 등, 선택). 같은 가구 안에서는 중복될 수 없다. 장치를 알아보는 용도이며 인증에는 쓰지 않는다(인증은 tokenHash).
  deviceId        String?
  name            String
  kind            SensorKind @default(MOTION)
  zone            ZoneKind
  origin          DataOrigin
  tokenHash       String     @unique // 장치 토큰의 SHA-256. 원문은 발급 시 1회만 보여 준다.
  isActive        Boolean    @default(true)
  lastSeenAt      DateTime?
  /// 마지막으로 heartbeat(상태 보고)를 받은 시각. 움직임 신호도 센서가 살아 있다는 뜻이라 lastSeenAt 은 갱신하지만, 이 값은 heartbeat 만 기록한다.
  lastHeartbeatAt DateTime?
  /// 이 센서의 연결 끊김 기준(초). null 이면 가구 기본(DetectionSettings.offlineAfterSeconds)을 쓴다. 배터리 센서처럼 신호 간격이 긴 장치용.
  offlineAfterSeconds Int?
  /// 이 센서가 보낸 데이터를 서버가 받지 못한(거부·형식 오류) 누적 횟수와 마지막 기록
  receiveErrorCount   Int       @default(0)
  lastReceiveErrorAt  DateTime?
  lastReceiveError    String?
  batteryPercent  Int?
  firmwareVersion String?
  /// 이 센서에만 적용하는 서버 판단 민감도. null 이면 가구 기본(DetectionSettings.sensitivity)을 따른다.
  sensitivity     Sensitivity?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  household  Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events     MovementEvent[]
  statusLogs SensorStatusLog[]
  alerts     Alert[]

  @@unique([householdId, deviceId])
  @@index([householdId, zone])
}

model SensorStatusLog {
  id       String              @id @default(cuid())
  sensorId String
  at       DateTime            @default(now())
  kind     SensorStatusLogKind
  detail   String?

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, at])
}

model MovementEvent {
  id            String     @id @default(cuid())
  householdId   String
  sensorId      String
  zone          ZoneKind // 이벤트 시점의 센서 구역을 복사한다. 센서 구역이 바뀌어도 기록은 보존된다.
  origin        DataOrigin
  deviceEventId String // 장치가 만든 UUID. 중복 전송을 막는다.
  occurredAt    DateTime // 장치 기준 발생 시각
  receivedAt    DateTime   @default(now())
  isLate        Boolean    @default(false)
  /// 받을 때 판단 엔진이 정한 분류. 이후 설정이 바뀌어도 과거 기록의 분류는 바뀌지 않는다.
  eventClass    MovementClass @default(MOTION_DETECTED)

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sensor    Sensor          @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  evidence  AlertEvidence[]

  @@unique([sensorId, deviceEventId])
  @@index([householdId, eventClass, occurredAt])
  @@index([householdId, occurredAt])
  @@index([sensorId, occurredAt])
}

model Alert {
  id               String        @id @default(cuid())
  householdId      String
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  origin           DataOrigin
  title            String // 사용자에게 보이는 문장. 확정적 표현 금지 (계획서 2.1)
  message          String
  sensorId         String?
  triggeredAt      DateTime
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolution       Resolution?
  note             String?
  dedupeKey        String // 반복 억제용: type + sensor/zone
  lastEventAt      DateTime      @default(now()) // 이 알림에 합쳐진 마지막 신호 시각. 반복 억제 기준
  occurrences      Int           @default(1) // 합쳐진 신호 수
  lastNotifiedAt   DateTime      @default(now()) // 마지막으로 알림을 보낸 시각. 재알림 기준
  reminderCount    Int           @default(0)

  household  Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sensor     Sensor?                @relation(fields: [sensorId], references: [id], onDelete: SetNull)
  evidence   AlertEvidence[]
  deliveries NotificationDelivery[]
  reads      AlertRead[]
  clips      AlertClip[]

  @@index([householdId, status, triggeredAt])
  @@index([householdId, dedupeKey])
}

/// 알림에 붙은 짧은 영상(시연용 웹캠). 개인정보이므로 보관 기간이 지나면 주기 점검이 지운다.
/// 알림이 새로 만들어진 순간의 영상만 저장하고, 알림이 지워지면 함께 지워진다.
model AlertClip {
  id          String   @id @default(cuid())
  alertId     String
  householdId String
  mimeType    String
  sizeBytes   Int
  durationMs  Int?
  data        Bytes
  createdAt   DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@index([createdAt])
}

model AlertEvidence {
  alertId String
  eventId String

  alert Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  event MovementEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([alertId, eventId])
}

/// 보호자가 알림을 "읽음"으로 표시한 기록. 알림을 확인·종료(처리 상태)하는 것과는 별개다.
/// 읽었다고 해서 상황이 해결된 것이 아니다. 보호자마다 따로 저장한다.
model AlertRead {
  alertId    String
  guardianId String
  readAt     DateTime @default(now())

  alert    Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([alertId, guardianId])
  @@index([guardianId])
}

model NotificationDelivery {
  id            String         @id @default(cuid())
  alertId       String
  guardianId    String
  channel       Channel
  providerMode  ProviderMode? // REAL / MOCK 을 기록에 남긴다. 연동되지 않은 채널(NOT_CONFIGURED)은 null
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime? // PENDING 일 때 다음 재시도 시각
  sentAt        DateTime?
  createdAt     DateTime       @default(now())

  alert    Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([guardianId])
  /// 재시도 대상(PENDING 이고 다음 시도 시각이 지난 것)을 찾는 주기 점검용
  @@index([status, nextAttemptAt])
}
