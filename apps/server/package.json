{
  "name": "@tetris/server",
  "version": "0.1.0",
  "private": true,
  "description": "노크 API 서버 (Express + Socket.IO)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tetris/shared": "*",
    "@tetris/simulator": "*",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tetris/simulator": "*",
    "@types/express": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
