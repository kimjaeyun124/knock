# 의존성·빌드 산출물
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/

# 환경변수 (예제 파일만 커밋)
.env
.env.*
!.env.example

# 로컬 DB와 Prisma 생성물 (Phase 1 이후)
apps/server/prisma/*.db
apps/server/prisma/*.db-journal
apps/server/prisma/*.db-wal
apps/server/prisma/*.db-shm
apps/server/prisma/generated/

# 테스트 산출물 (Playwright, Phase 8)
playwright-report/
test-results/
# E2E 가 만드는 임시 DB와 로그인 상태(가상 계정)
apps/server/prisma/e2e.db*
e2e/.auth/

# 로그·OS·에디터
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma 생성 클라이언트 (npm install 시 postinstall 로 다시 만들어진다)
apps/server/src/generated/
